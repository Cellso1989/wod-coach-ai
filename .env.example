# Database
# Local Docker/Postgres default. For Supabase in production, use:
# - DATABASE_URL: Transaction Pooler URL (port 6543) for the running app.
# - DIRECT_URL: Direct Connection URL for Prisma CLI/migrations.
DATABASE_URL="postgresql://wodcoach:wodcoach@localhost:5432/wod_coach_ai?schema=public"
DIRECT_URL="postgresql://wodcoach:wodcoach@localhost:5432/wod_coach_ai?schema=public"
POSTGRES_USER=wodcoach
POSTGRES_PASSWORD=wodcoach
POSTGRES_DB=wod_coach_ai

# API
API_PORT=3333
API_HOST=0.0.0.0
JWT_SECRET=replace-with-a-strong-random-secret
NODE_ENV=development
# Requisições por IP por minuto. Padrões pensados para 1 usuário local
# + testes E2E em paralelo; aperte em produção multi-usuário se precisar.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=100
PASSWORD_RESET_RATE_LIMIT_MAX=10
AI_DAILY_LIMIT=5
AI_DAILY_LIMIT_TIME_ZONE=America/Sao_Paulo
# Public app origin (HTTPS in production). Never use the database connection URL here.
PASSWORD_RESET_BASE_URL=http://localhost:5173
# Optional for the administrator's manual recovery links; required for automatic email.
# Resend requires a verified sending domain to reach other athletes.
RESEND_API_KEY=
# Example after verifying your own domain: WOD Coach AI <acesso@seu-dominio.com.br>
PASSWORD_RESET_FROM=

# Web Push (optional). Generate once with: pnpm --filter @wod-coach-ai/api exec web-push generate-vapid-keys
# Keep the private key only on the server; use the same key pair across deployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Web
VITE_API_URL=http://localhost:3333

# OpenAI API
OPENAI_API_KEY=
# Opcional: sobrescreve o modelo padrao definido no codigo (ex: gpt-5, gpt-5-mini)
OPENAI_MODEL=
