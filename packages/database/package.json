{
  "name": "@wod-coach-ai/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "dotenv -e ../../.env -- prisma generate --schema ../../prisma/schema.prisma",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev --schema ../../prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "dotenv-cli": "^7.4.4"
  }
}
